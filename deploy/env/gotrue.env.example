# Rasid GoTrue — installs to /etc/rasid/gotrue.env (mode 640, root:rasid)
#
# ⚠️ VERIFY AGAINST THE DOWNLOADED RELEASE BEFORE FIRST START.
# GoTrue's env var names have drifted between versions, and the asymmetric-key
# settings are recent. The install step pins a release and checks these names
# against that exact version; do not assume this file is correct for every tag.

# --- Bind: loopback only; Caddy is the only public listener -------------------
GOTRUE_API_HOST=127.0.0.1
GOTRUE_API_PORT=7120

# --- Public identity ----------------------------------------------------------
# The external origin GoTrue believes it is serving. Must match what Caddy
# fronts, because the links it emails (confirm/recovery) are built from it.
API_EXTERNAL_URL=https://rasid.204.44.93.211.sslip.io

# --- Database: its OWN role, its OWN schema, same `rasid` database ------------
# GoTrue runs its own migrations and owns the `auth` schema. The application
# roles are NOT granted on that schema: the app learns identity from the
# verified token, never by reading auth tables. That separation is why a
# compromise of app_runtime cannot read password hashes.
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_DATABASE_URL=postgresql://rasid_auth:__RASID_AUTH_PASSWORD__@127.0.0.1:5432/rasid
GOTRUE_DB_NAMESPACE=auth
# CAP THE POOL. The cluster shares 50 connections (47 usable) with an unrelated
# production project, and migration 0073's budget counted only the three app
# roles (14+4+4) plus the neighbour's measured 15 — it did NOT count GoTrue.
# Left unset, GoTrue's pool is free to grow and spend the 10-connection
# headroom that budget depends on. 5 is ample for an auth server that is only
# touched at signup/login/recovery, and migration 0074 caps the `rasid_auth`
# role at 7 as the hard backstop (pool + a little transient overlap).
GOTRUE_DB_MAX_POOL_SIZE=5

# --- JWT: ASYMMETRIC, and this is non-negotiable ------------------------------
# The API's verifier accepts a remote JWKS only — there is NO shared-secret
# code path. So GoTrue must sign with a private key and publish the public one
# at /auth/v1/.well-known/jwks.json.
#
# Generate all three of the following with:
#   node deploy/scripts/generate-auth-keys.mjs --issuer <SUPABASE_URL>/auth/v1
#
# GOTRUE_JWT_SECRET is still required even with asymmetric signing: self-hosted
# GoTrue keeps a legacy symmetric key inside JWT_KEYS, and the anon key the web
# bundle sends is an HS256 JWT signed with this secret.
GOTRUE_JWT_SECRET=__JWT_SECRET__
# A JSON ARRAY of signing JWKs: the EC P-256 PRIVATE key (signs new tokens)
# plus that legacy symmetric key. GoTrue excludes the symmetric entry from the
# published JWKS, so only the EC public half is ever served.
GOTRUE_JWT_KEYS=__JWT_KEYS_JSON_ARRAY__
GOTRUE_JWT_VALID_METHODS=ES256
# This MUST equal <SUPABASE_URL>/auth/v1 from api.env, character for character.
# A mismatch produces blanket 401s with a valid-looking token — the first thing
# to check if every request is rejected after a domain change.
GOTRUE_JWT_ISSUER=https://rasid.204.44.93.211.sslip.io/auth/v1
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_EXP=3600

# --- Signup & redirects -------------------------------------------------------
GOTRUE_SITE_URL=https://rasid.204.44.93.211.sslip.io
# Exact allowlist of post-auth redirect targets — the `redirect_to` values the
# app actually asks for. `/reset-password` is the one `forgot-password` sends;
# the bare origin covers signup confirmation landing on the app root. An
# `/auth/callback` entry was listed here previously but no such route exists in
# the web app, so it is deliberately gone.
GOTRUE_URI_ALLOW_LIST=https://rasid.204.44.93.211.sslip.io/reset-password,https://rasid.204.44.93.211.sslip.io
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
# Keep email confirmation ON. Autoconfirm would let anyone create an account
# against an address they do not control.
GOTRUE_MAILER_AUTOCONFIRM=false

# --- Email via Resend SMTP (already a project dependency) ---------------------
GOTRUE_SMTP_HOST=smtp.resend.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=resend
GOTRUE_SMTP_PASS=__RESEND_API_KEY__
GOTRUE_SMTP_ADMIN_EMAIL=__SENDER_EMAIL__
GOTRUE_SMTP_SENDER_NAME=Rasid
# Outbound port 25 is typically blocked on this kind of host and self-hosted
# mail would land in spam, which is why a transactional provider is used.

# --- Mail link paths: these are GoTrue's OWN verify endpoint, not app routes --
# A mailed link must land on GoTrue so it can CONSUME the one-time token and
# only then redirect into the app. Pointing these at an app route (e.g. an
# `/auth/callback` page) bypasses `/auth/v1/verify` entirely: the token is
# never exchanged, so confirmation and password recovery both fail — and if
# the app has no such route it is a plain 404.
#
# The app does not implement a callback route at all. `forgot-password` passes
# `redirectTo = <APP_URL>/reset-password`, GoTrue appends it to the verify URL,
# and `reset-password` picks the session out of the URL fragment via
# supabase-js `detectSessionInUrl: true`. So the app route is supplied per
# request by the client; what belongs here is GoTrue's own path.
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_RECOVERY=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_INVITE=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# --- Logging ------------------------------------------------------------------
GOTRUE_LOG_LEVEL=info
