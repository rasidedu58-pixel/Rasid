# Rasid API — installs to /etc/rasid/api.env  (mode 640, root:rasid)
# Every __PLACEHOLDER__ is filled ON THE SERVER. Secrets are generated there
# with `openssl rand` and never leave it.

NODE_ENV=production

# Bind to loopback ONLY. The host's security model is "nothing but Caddy is
# reachable"; UFW is the second layer, not the first. The code defaults to
# 0.0.0.0 (so container/PaaS runtimes keep working), so this line is what
# makes the service loopback-bound — it is not optional here.
HOST=127.0.0.1
# 7100 is reserved for Rasid after a live port audit. The code's default is
# 3000, which is ALREADY TAKEN on this host by the neighbouring project's
# PostgREST — omitting this line would start a second process on a busy port
# and produce the exact "works, then breaks for no reason" failure the host's
# runbook warns about.
PORT=7100

# --- Database: one role per concern, all over loopback -----------------------
# Role CONNECTION LIMITs are set by migration 0073 (14 / 4 / 4).
DATABASE_URL=postgresql://app_runtime:__APP_RUNTIME_PASSWORD__@127.0.0.1:5432/rasid
PLATFORM_ADMIN_DATABASE_URL=postgresql://app_platform_admin:__APP_PLATFORM_ADMIN_PASSWORD__@127.0.0.1:5432/rasid
# MIGRATION_DATABASE_URL is deliberately ABSENT from the service environment.
# Migrations run from a workstation over an SSH tunnel with the privileged
# role; a long-running request handler must never hold migration rights.

# Pool sizes must stay under the role limits above.
DB_POOL_MAX=10
PLATFORM_ADMIN_DB_POOL_MAX=3

# --- Auth: self-hosted GoTrue, same origin -----------------------------------
# The verifier derives BOTH the JWKS URL and the expected issuer from this one
# base, so it must be the public origin exactly (no trailing slash):
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json
#   <SUPABASE_URL>/auth/v1   == GOTRUE_JWT_ISSUER
# A mismatch here is the single most likely cause of blanket 401s.
SUPABASE_URL=https://rasid.204.44.93.211.sslip.io
# SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are intentionally unset:
# verified unused by server code. The service role key especially — nothing
# calls an auth admin API, and an unused secret is only a liability.

# --- Origins -----------------------------------------------------------------
# Same-origin deployment, so this is belt-and-braces rather than load-bearing.
# Never a wildcard.
CORS_ALLOWED_ORIGINS=https://rasid.204.44.93.211.sslip.io

# --- Email (already an integrated dependency) --------------------------------
RESEND_API_KEY=__RESEND_API_KEY__

# --- Observability (optional; leave blank to disable) ------------------------
SENTRY_DSN=
POSTHOG_API_KEY=

# --- Billing contact details (shown in-app) ----------------------------------
RASID_BILLING_WHATSAPP_NUMBER=
RASID_INSTAPAY_HANDLE=
RASID_VODAFONE_CASH_NUMBER=

# --- Paddle (only if/when online payments are enabled) -----------------------
# PADDLE_ENVIRONMENT=
# PADDLE_API_KEY=
# PADDLE_PRICE_ID=
# PADDLE_WEBHOOK_SECRET=

# --- Not used on this host ---------------------------------------------------
# REDIS_URL — only the worker needs it, and the worker is not deployed.
# R2_* — object storage is declared in the schema but unused in code.
