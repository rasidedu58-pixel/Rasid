# Rasid Web — BUILD-TIME env. Used on the machine that runs `next build`
# (a workstation or CI), NOT installed on the server.
#
# These are compiled INTO the bundle. If one of them is wrong, the fix is a
# rebuild and reship — not a server restart. They are also public: anything
# here ships to every browser, so never put a secret in this file.

# The API's public base. Note the /api/v1 suffix: the API serves everything
# under that prefix, and the web client throws at startup if this is unset
# (deliberately — a silent fallback to localhost once shipped a broken build).
NEXT_PUBLIC_API_URL=https://rasid.204.44.93.211.sslip.io/api/v1

# The app's own public origin (used for absolute links / redirects).
NEXT_PUBLIC_APP_URL=https://rasid.204.44.93.211.sslip.io

# Self-hosted GoTrue, same origin. supabase-js appends /auth/v1 itself, so
# this is the bare origin — it must match the API's SUPABASE_URL exactly.
NEXT_PUBLIC_SUPABASE_URL=https://rasid.204.44.93.211.sslip.io
# GoTrue's anon key. supabase-js requires one; with standalone GoTrue (no API
# gateway in front) it is not an access-control boundary — the real gate is the
# API's token verification plus database authorization. Not a secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=__ANON_KEY__

# Offline PWA stays OFF for this cutover (the offline work is unmerged WIP).
NEXT_PUBLIC_OFFLINE=false

# Optional client observability.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
