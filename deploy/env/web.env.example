# Rasid Web — RUNTIME env. Installs to /etc/rasid/web.env (mode 640, root:rasid)
#
# ⚠️ READ THIS BEFORE ADDING ANYTHING HERE ⚠️
# Next.js inlines every NEXT_PUBLIC_* value into the JavaScript bundle at
# BUILD time. Putting one in this file has NO EFFECT — the built artifact
# already contains whatever value was present when it was compiled. Public
# values belong in deploy/env/web.build.env.example and require a REBUILD and
# RESHIP to change. This file carries only what the server process reads at
# runtime.

NODE_ENV=production

# Next's standalone server reads HOSTNAME (not HOST) for its bind address.
HOSTNAME=127.0.0.1
PORT=7110

# Server-side Sentry (read at runtime by instrumentation). Blank = disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
