{
  "name": "@academic-precision/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:validate-migrations": "tsx src/scripts/validate-migrations.ts",
    "scale:seed": "tsx src/scripts/seed-scale-dataset.ts",
    "scale:cleanup": "tsx src/scripts/cleanup-scale-dataset.ts",
    "scale:load-test": "tsx src/scripts/load-test-db-layer.ts",
    "scale:bench-reports": "tsx src/scripts/bench-reports.ts",
    "recovery:seed": "tsx src/scripts/recovery-seed-fixture.ts",
    "recovery:cleanup": "tsx src/scripts/recovery-cleanup-fixture.ts",
    "recovery:manifest": "tsx src/scripts/recovery-capture-manifest.ts",
    "recovery:dump": "tsx src/scripts/recovery-dump-data.ts",
    "recovery:verify": "tsx src/scripts/recovery-verify-manifest.ts"
  },
  "dependencies": {
    "@academic-precision/contracts": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "zod": "^3.24.1",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2",
    "@types/luxon": "^3.4.2"
  }
}
