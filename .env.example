# Academic Precision — Teacher V1
# Environment variable reference. NAMES + DESCRIPTIONS ONLY. Never commit real values.
# Copy to .env (root) and/or per-app .env.local as needed for local development.

# ---------------------------------------------------------------------------
# Database (PostgreSQL, managed initially via Supabase)
# ---------------------------------------------------------------------------
# Full PostgreSQL connection string used by packages/database and apps/api.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase (Auth + managed Postgres)
# ---------------------------------------------------------------------------
# Supabase project URL.
SUPABASE_URL=
# Public anon key, safe for browser use with RLS enforced.
SUPABASE_ANON_KEY=
# Server-only service role key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe mirror of the Supabase URL for apps/web.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe mirror of the Supabase anon key for apps/web.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Redis / BullMQ (apps/worker, apps/api)
# ---------------------------------------------------------------------------
# Redis connection string used for BullMQ queues/cache. Never a source of truth.
REDIS_URL=

# ---------------------------------------------------------------------------
# Transactional email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2 / S3-compatible)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# ---------------------------------------------------------------------------
# Billing (Paddle)
# ---------------------------------------------------------------------------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=

# ---------------------------------------------------------------------------
# Observability (Sentry)
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Product analytics (PostHog) — no student/guardian PII
# ---------------------------------------------------------------------------
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# apps/web
# ---------------------------------------------------------------------------
# Public base URL of the web app.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
# Port the NestJS/Fastify server listens on.
PORT=
# Runtime environment name: development | staging | production.
NODE_ENV=
