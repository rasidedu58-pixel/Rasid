# Rasid load-test harness — STAGING ONLY.
# Copy to .env (which is gitignored) and fill in staging values.
# NEVER put production URLs or credentials here.

# --- Target (must be staging; the harness refuses non-staging hosts) ---
# Host must contain "staging" or "localhost", otherwise set LOAD_TEST_ALLOW_UNSAFE=1.
LOAD_TEST_API_URL=https://academic-precisionapi-staging.up.railway.app

# --- Supabase auth (staging project) ---
LOAD_TEST_SUPABASE_URL=https://your-staging-ref.supabase.co
# Use the staging anon key (NOT service_role).
LOAD_TEST_SUPABASE_KEY=your-staging-anon-key

# --- QA user + workspace to drive load against ---
LOAD_TEST_EMAIL=qa-user@example.com
LOAD_TEST_PASSWORD=the-qa-user-password
LOAD_TEST_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# --- Writes (OFF by default) ---
# Only used when the runner is started with --writes=on. Must be an ISOLATED
# fixture session that is safe to mutate repeatedly (started / in-progress).
# LOAD_TEST_WRITE_SESSION_ID=00000000-0000-0000-0000-000000000000

# --- Override (use with extreme care) ---
# Set to 1 ONLY to allow a non-staging, non-localhost host. Never for production.
# LOAD_TEST_ALLOW_UNSAFE=1
