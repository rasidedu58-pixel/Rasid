# scale-seed environment — STAGING ONLY. Copy to `.env` and fill in.
# Load it into your shell before running (e.g. `set -a; . ./.env; set +a`
# on bash, or use `dotenv`/`env $(cat .env | xargs)`). The tool does NOT
# auto-load this file.

# The STAGING (privileged / migration-level) Postgres connection string.
# It must bypass RLS to insert cross-tenant fixtures, so use the migration/
# owner role connection — NEVER the app_runtime role, and NEVER production.
# The host must contain "supabase.co" (this also matches the Supabase
# "*.pooler.supabase.com" pooler host) or the tool refuses to run.
SCALE_SEED_DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-STAGING-REF.supabase.co:5432/postgres

# Explicit staging opt-in. The tool REFUSES to run unless this is exactly "1".
# This is your confirmation that the target above is a disposable STAGING
# database and NOT production.
SCALE_SEED_ALLOW=1
